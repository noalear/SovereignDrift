; Engine configuration file.
; It's actually a TOML-like file. Godot writes it; hand edits are fine.

config_version=5

[application]

config/name="Stellar Frontier"
config/description="A modern remake of Stardock's 1997 space combat game."
config/version="0.1.0"
run/main_scene="res://src/Main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
run/low_processor_mode=false
config/icon="res://assets/icon.svg"

[autoload]

Settings="*res://src/autoload/Settings.gd"
GameData="*res://src/autoload/GameData.gd"
Music="*res://src/autoload/Music.gd"
Sfx="*res://src/autoload/Sfx.gd"
Net="*res://src/net/Net.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

