; Stellar Frontier Enhanced Edition -- Godot 4 application around the original
; 1997 program.  NEW FILE 2026-10-12; Enhanced Edition 2026-10-13.

config_version=5

[application]

config/name="Stellar Frontier Enhanced"
config/description="Stellar Frontier (Stardock) on Godot 4: Enhanced Edition."
run/main_scene="res://launcher.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[autoload]

Settings="*res://settings.gd"
Paths="*res://paths.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="disabled"
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
