; Stellar Frontier -- Godot 4 application around the original 1997 program.
; NEW FILE, added 2026-10-12 for the Stellar Frontier Godot port.

config_version=5

[application]

config/name="Stellar Frontier"
config/description="Stellar Frontier (Stardock), the original game running on Godot 4."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/size/resizable=true
window/stretch/mode="disabled"
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
